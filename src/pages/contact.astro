---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with DevToolkit."
>
  <div class="max-w-2xl mx-auto px-4 py-16 prose prose-invert prose-slate">
    <h1>Contact</h1>
    <p>
      Found a bug, have a tool request, or want to report an issue? Email us
      at <a href="mailto:hello@example.com">hello@example.com</a>.
    </p>
    <p><em>Replace this email with your actual contact address before publishing.</em></p>
  </div>
</BaseLayout>
