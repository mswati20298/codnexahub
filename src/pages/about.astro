---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="Learn about CodnexaHub — free, fast tools for AI developers."
>
  <div class="max-w-2xl mx-auto px-4 py-16 prose prose-slate dark:prose-invert">
    <h1>About CodnexaHub</h1>
    <p>
      CodnexaHub is a growing collection of free, no-signup tools built for
      developers working with AI APIs. Each tool solves one specific,
      everyday problem — no accounts, no clutter, just a fast answer.
    </p>
    <p>
      This site is built and maintained independently. If you spot an issue
      with a tool or have a request for a new one, reach out via the
      <a href="/contact">contact page</a>.
    </p>
  </div>
</BaseLayout>
