---
import BaseLayout from '../layouts/BaseLayout.astro';
import { tools } from '../data/tools.js';

const popular = tools.slice(0, 6);
---
<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist.">
  <div class="max-w-2xl mx-auto px-4 py-20 text-center">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-100 mb-3">404</h1>
    <p class="text-slate-500 dark:text-slate-400 mb-8">This page doesn't exist — but the tool you're looking for probably does.</p>

    <a href="/#tools" class="inline-flex items-center gap-2 bg-emerald-500 hover:bg-emerald-600 text-white rounded-lg px-5 py-2.5 text-sm font-medium mb-10 transition-colors">
      Browse all tools
    </a>

    <div class="text-left">
      <p class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wide mb-3">Popular tools</p>
      <div class="grid sm:grid-cols-2 gap-2">
        {popular.map((t) => (
          <a href={t.href} class="text-sm text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg px-4 py-2.5">
            {t.name}
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
