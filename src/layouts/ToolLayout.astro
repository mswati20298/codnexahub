---
import BaseLayout from './BaseLayout.astro';
import CategoryIcon from '../components/CategoryIcon.jsx';
import { tools } from '../data/tools.js';
import { getCategoryMeta } from '../data/categoryMeta.js';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const currentTool = tools.find((t) => t.href === currentPath);
const category = currentTool?.category || 'Developer';
const categorySlug = getCategoryMeta(category).slug;
const categoryHref = `/tools/category/${categorySlug}`;
const related = currentTool
  ? tools.filter((t) => t.category === category && t.href !== currentTool.href).slice(0, 5)
  : [];

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://example.com';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": category, "item": `${siteUrl}${categoryHref}` },
    { "@type": "ListItem", "position": 3, "name": title, "item": `${siteUrl}${currentPath}` },
  ],
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": title,
  "description": description,
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Any (runs in browser)",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
};

// Derived from the page's own rendered FAQ markup (`<h2>FAQ</h2>` followed by
// `<p><strong>Question?</strong> Answer</p>` pairs) so the schema can never drift
// from what's visibly on the page.
const bodyHtml = Astro.slots.has('default') ? await Astro.slots.render('default') : '';

function decodeEntities(str: string): string {
  return str
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#0?39;/g, "'")
    .replace(/&nbsp;/g, ' ');
}

function stripTags(str: string): string {
  return decodeEntities(str.replace(/<[^>]+>/g, '')).trim();
}

let faqSchema: Record<string, unknown> | null = null;
const faqSectionMatch = bodyHtml.match(/<h2>[^<]*\bFAQs?\b[^<]*<\/h2>([\s\S]*)$/i);
if (faqSectionMatch) {
  const qaPairs: { "@type": string; name: string; acceptedAnswer: { "@type": string; text: string } }[] = [];
  const qaRegex = /<p>\s*<strong>([\s\S]+?)<\/strong>\s*([\s\S]*?)<\/p>/g;
  let match: RegExpExecArray | null;
  while ((match = qaRegex.exec(faqSectionMatch[1]))) {
    const question = stripTags(match[1]);
    const answer = stripTags(match[2]);
    if (question && answer) {
      qaPairs.push({
        "@type": "Question",
        "name": question,
        "acceptedAnswer": { "@type": "Answer", "text": answer },
      });
    }
  }
  if (qaPairs.length > 0) {
    faqSchema = {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": qaPairs,
    };
  }
}
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <div class="max-w-6xl mx-auto px-4 py-8">
    <nav class="text-sm text-slate-500 dark:text-slate-400 mb-6 flex items-center gap-2 flex-wrap" aria-label="Breadcrumb">
      <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400">Home</a>
      <span>/</span>
      <a href={categoryHref} class="hover:text-emerald-600 dark:hover:text-emerald-400">{category}</a>
      <span>/</span>
      <span class="text-slate-700 dark:text-slate-300">{title}</span>
    </nav>

    <div class="grid lg:grid-cols-[1fr_280px] gap-8">
      <div class="min-w-0">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 mb-6 shadow-sm">
          <div class="flex items-start gap-4 mb-4">
            <CategoryIcon category={category} size="lg" client:load />
            <div>
              <div class="flex items-center gap-2 flex-wrap mb-1">
                <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100">{title}</h1>
                {currentTool?.byok && (
                  <span class="text-[10px] uppercase tracking-wide font-medium px-2 py-0.5 rounded-full bg-amber-100 text-amber-700 dark:bg-amber-950/50 dark:text-amber-400 border border-amber-300 dark:border-amber-900">
                    BYOK
                  </span>
                )}
              </div>
              <p class="text-slate-500 dark:text-slate-400">{description}</p>
            </div>
          </div>
          <div class="flex flex-wrap gap-2 text-xs text-slate-500 dark:text-slate-400">
            <span class="inline-flex items-center gap-1 bg-slate-100 dark:bg-slate-800 rounded-full px-3 py-1">100% Free</span>
            <span class="inline-flex items-center gap-1 bg-slate-100 dark:bg-slate-800 rounded-full px-3 py-1">No Signup</span>
            <span class="inline-flex items-center gap-1 bg-slate-100 dark:bg-slate-800 rounded-full px-3 py-1">Works Offline</span>
          </div>
        </div>

        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 mb-8 shadow-sm">
          <slot name="tool" />
        </div>

        <article class="prose prose-slate dark:prose-invert max-w-none prose-headings:text-slate-900 dark:prose-headings:text-slate-100">
          <slot />
        </article>
      </div>

      <aside class="hidden lg:block">
        <div class="sticky top-20 space-y-6">
          {related.length > 0 && (
            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-4">
              <p class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wide mb-3">Related Tools</p>
              <ul class="space-y-1">
                {related.map((t) => (
                  <li>
                    <a href={t.href} class="block text-sm text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 px-2 py-1.5 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
                      {t.name}
                    </a>
                  </li>
                ))}
              </ul>
              <a href={categoryHref} class="block text-xs text-emerald-600 dark:text-emerald-400 hover:underline mt-3 px-2">
                View all {category} tools &rarr;
              </a>
            </div>
          )}
          <div class="bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-900 rounded-xl p-4">
            <p class="text-sm font-semibold text-emerald-700 dark:text-emerald-400 mb-1">Love CodnexaHub?</p>
            <p class="text-xs text-emerald-700/80 dark:text-emerald-400/70 mb-3">Share it with other developers.</p>
            <a href="/" class="block text-center text-sm bg-emerald-500 hover:bg-emerald-600 text-white rounded-lg py-2 transition-colors">
              Browse All Tools
            </a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
