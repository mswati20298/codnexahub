---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.jsx';
import MobileMenu from '../components/MobileMenu.jsx';
import BottomTabBar from '../components/BottomTabBar.jsx';
import HeaderSearch from '../components/HeaderSearch.jsx';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://example.com';
const canonical = `${siteUrl}${Astro.url.pathname}`;
const isHomepage = Astro.url.pathname === '/';
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#020617" media="(prefers-color-scheme: dark)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="CodnexaHub" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{title} | CodnexaHub</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "CodnexaHub",
      "url": siteUrl
    })} />

    <script is:inline>
      // Runs before paint to avoid a light/dark flash on load.
      (function () {
        const saved = localStorage.getItem("devtoolkit_theme");
        const isDark = saved === "dark";
        document.documentElement.classList.toggle("dark", isDark);
      })();
    </script>

    <Analytics />
  </head>
  <body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 min-h-screen flex flex-col transition-colors overflow-x-hidden pb-16 md:pb-0">
    <header class="relative border-b border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-950/80 backdrop-blur sticky top-0 z-40">
      <nav class="max-w-[1440px] mx-auto px-4 py-3.5 flex items-center gap-6 min-h-[64px]">
        <a href="/" class="flex items-center gap-2 font-semibold text-lg tracking-tight text-slate-900 dark:text-slate-100 shrink-0">
          <span class="text-emerald-500">{"</>"}</span>
          Codnexa<span class="text-emerald-500">Hub</span>
        </a>

        <div class="hidden md:flex items-center gap-5 text-sm text-slate-600 dark:text-slate-400">
          <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a>
          <a href="/#tools" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">All Tools</a>
          <a href="/guides" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Guides</a>
          <a href="/blog" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Blog</a>
          <a href="/about" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">About</a>
        </div>

        {!isHomepage && <HeaderSearch client:load />}

        <div class="flex items-center gap-2 ml-auto md:ml-0">
          <ThemeToggle client:load />
          <MobileMenu client:load />
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-slate-200 dark:border-slate-800 mt-16 bg-white dark:bg-slate-950">
      <div class="max-w-[1440px] mx-auto px-4 py-10 hidden md:grid sm:grid-cols-2 md:grid-cols-4 gap-8">
        <div>
          <a href="/" class="flex items-center gap-2 font-semibold text-slate-900 dark:text-slate-100 mb-2">
            <span class="text-emerald-500">{"</>"}</span>
            Codnexa<span class="text-emerald-500">Hub</span>
          </a>
          <p class="text-sm text-slate-500 dark:text-slate-400">Free developer tools to make your work faster and easier.</p>
        </div>
        <div>
          <p class="text-sm font-semibold text-slate-900 dark:text-slate-100 mb-3">Explore</p>
          <ul class="space-y-2 text-sm text-slate-500 dark:text-slate-400">
            <li><a href="/#tools" class="hover:text-emerald-600 dark:hover:text-emerald-400">All Tools</a></li>
            <li><a href="/guides" class="hover:text-emerald-600 dark:hover:text-emerald-400">Guides</a></li>
            <li><a href="/blog" class="hover:text-emerald-600 dark:hover:text-emerald-400">Blog</a></li>
          </ul>
        </div>
        <div>
          <p class="text-sm font-semibold text-slate-900 dark:text-slate-100 mb-3">Resources</p>
          <ul class="space-y-2 text-sm text-slate-500 dark:text-slate-400">
            <li><a href="/about" class="hover:text-emerald-600 dark:hover:text-emerald-400">About</a></li>
            <li><a href="/contact" class="hover:text-emerald-600 dark:hover:text-emerald-400">Contact</a></li>
          </ul>
        </div>
        <div>
          <p class="text-sm font-semibold text-slate-900 dark:text-slate-100 mb-3">Legal</p>
          <ul class="space-y-2 text-sm text-slate-500 dark:text-slate-400">
            <li><a href="/privacy-policy" class="hover:text-emerald-600 dark:hover:text-emerald-400">Privacy Policy</a></li>
            <li><a href="/terms" class="hover:text-emerald-600 dark:hover:text-emerald-400">Terms of Use</a></li>
            <li><a href="/disclaimer" class="hover:text-emerald-600 dark:hover:text-emerald-400">Disclaimer</a></li>
            <li><a href="/cookie-policy" class="hover:text-emerald-600 dark:hover:text-emerald-400">Cookie Policy</a></li>
          </ul>
        </div>
      </div>
      <div class="md:hidden max-w-[1440px] mx-auto px-4 py-6 flex flex-wrap gap-x-4 gap-y-2 justify-center text-xs text-slate-500 dark:text-slate-400">
        <a href="/privacy-policy" class="hover:text-emerald-600 dark:hover:text-emerald-400">Privacy Policy</a>
        <a href="/terms" class="hover:text-emerald-600 dark:hover:text-emerald-400">Terms of Use</a>
        <a href="/disclaimer" class="hover:text-emerald-600 dark:hover:text-emerald-400">Disclaimer</a>
        <a href="/cookie-policy" class="hover:text-emerald-600 dark:hover:text-emerald-400">Cookie Policy</a>
        <a href="/contact" class="hover:text-emerald-600 dark:hover:text-emerald-400">Contact</a>
      </div>
      <div class="border-t border-slate-200 dark:border-slate-800">
        <div class="max-w-[1440px] mx-auto px-4 py-4 text-xs text-slate-400 dark:text-slate-500 flex justify-between">
          <p>&copy; {new Date().getFullYear()} CodnexaHub. All rights reserved.</p>
          <p>Made for developers.</p>
        </div>
      </div>
    </footer>

    <BottomTabBar currentPath={currentPath} client:load />
  </body>
</html>
